{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "documentation": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^docs-v[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.[1-9][0-9]*$"
        },
        "scope": {
          "const": "edition_in_this_tree"
        },
        "maturity": {
          "const": "prerelease"
        },
        "release_url": {
          "type": "string",
          "format": "uri"
        },
        "repository_id": {
          "const": 1419912178
        }
      },
      "required": [
        "version",
        "scope",
        "maturity",
        "release_url",
        "repository_id"
      ],
      "additionalProperties": false
    },
    "FREE": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "distribution": {
          "const": "wordpress.org"
        },
        "observed_on": {
          "type": "string",
          "minLength": 1
        },
        "svn_revision": {
          "type": "integer",
          "minimum": 1
        },
        "file_count": {
          "type": "integer",
          "minimum": 1
        },
        "zip_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "version",
        "distribution",
        "observed_on",
        "svn_revision",
        "file_count",
        "zip_sha256",
        "source_commit"
      ],
      "additionalProperties": false
    },
    "PRO": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "version_basis": {
          "type": "string",
          "minLength": 1
        },
        "distribution_state": {
          "type": "string",
          "minLength": 1
        },
        "current_package_verified": {
          "const": false
        },
        "zip_sha256": {
          "type": "null"
        },
        "connected_qualification": {
          "const": "NOT_RUN"
        },
        "connected_qualification_scope": {
          "const": "Independent connected PRO execution in this documentation work only; publisher-confirmed launch operation is recorded separately."
        },
        "publisher_confirmation_ref": {
          "const": "sources/manifest-projection.json#/capability_observation/current_validation"
        }
      },
      "required": [
        "version",
        "version_basis",
        "distribution_state",
        "current_package_verified",
        "zip_sha256",
        "connected_qualification",
        "connected_qualification_scope",
        "publisher_confirmation_ref"
      ],
      "additionalProperties": false
    },
    "policy_status": {
      "type": "string",
      "minLength": 1
    },
    "divergences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "documentary_publications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/published_documentary_release"
      }
    }
  },
  "required": [
    "schema_version",
    "documentation",
    "FREE",
    "PRO",
    "policy_status",
    "divergences",
    "documentary_publications"
  ],
  "additionalProperties": false,
  "$defs": {
    "published_documentary_release": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "publication_state": {
          "const": "PUBLISHED_PRERELEASE"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "const": "historical_verified_tagged_release"
        },
        "release_url": {
          "type": "string",
          "format": "uri"
        },
        "repository_id": {
          "const": 1419912178
        },
        "release_id": {
          "type": "integer",
          "minimum": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "version",
        "publication_state",
        "published_at",
        "scope",
        "release_url",
        "repository_id",
        "release_id",
        "source_commit"
      ],
      "additionalProperties": false
    }
  }
}

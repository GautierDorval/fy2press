{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "documentation": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "publication_state": {
          "const": "LOCAL_CANDIDATE"
        },
        "published_at": {
          "type": "null"
        }
      },
      "required": [
        "version",
        "publication_state",
        "published_at"
      ],
      "additionalProperties": false
    },
    "FREE": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "distribution": {
          "const": "wordpress.org"
        },
        "observed_on": {
          "type": "string",
          "minLength": 1
        },
        "svn_revision": {
          "type": "integer",
          "minimum": 1
        },
        "file_count": {
          "type": "integer",
          "minimum": 1
        },
        "zip_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "version",
        "distribution",
        "observed_on",
        "svn_revision",
        "file_count",
        "zip_sha256",
        "source_commit"
      ],
      "additionalProperties": false
    },
    "PRO": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "version_basis": {
          "type": "string",
          "minLength": 1
        },
        "distribution_state": {
          "type": "string",
          "minLength": 1
        },
        "current_package_verified": {
          "const": false
        },
        "zip_sha256": {
          "type": "null"
        },
        "connected_qualification": {
          "const": "NOT_RUN"
        }
      },
      "required": [
        "version",
        "version_basis",
        "distribution_state",
        "current_package_verified",
        "zip_sha256",
        "connected_qualification"
      ],
      "additionalProperties": false
    },
    "policy_status": {
      "type": "string",
      "minLength": 1
    },
    "divergences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "documentation",
    "FREE",
    "PRO",
    "policy_status",
    "divergences"
  ],
  "additionalProperties": false
}
